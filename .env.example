# ===== Security =====
# MUST be true to use browser cookie auth
CHATGPT_BROWSER_AUTH=true
# Allow non-localhost callers (use with caution)
CHATGPT_BROWSER_AUTH_ALLOW_REMOTE=false

# ===== Browser Cookie Extraction =====
# Which browser to try first: arc, chrome, edge, firefox, brave
CHATGPT_BROWSER=brave
# Chromium profile name (e.g. Default, Profile 1, Profile 2)
CHATGPT_CHROME_PROFILE=Default
# Raw cookie string override — skips browser extraction entirely
# Format: name=value; name2=value2
CHATGPT_COOKIE=

# ===== ChatGPT Backend =====
CHATGPT_BASE_URL=https://chatgpt.com
CHATGPT_BROWSER_AUTH_BASE_URL=https://chatgpt.com
PROXY_URL=

# ===== External Solvers (optional) =====
# Turnstile solver URL — required if ChatGPT requests Turnstile challenge
TURNSTILE_SOLVER_URL=
# Arkose solver URL — required if ChatGPT requests Arkose challenge
ARKOSE_TOKEN_URL=

# ===== Grok =====
# Grok cookie auth is enabled by default (reads cookies from your browser)
GROK_BROWSER_AUTH=true
# Allow non-localhost callers for Grok (use with caution)
GROK_BROWSER_AUTH_ALLOW_REMOTE=false
# Which browser to try first for Grok cookies: arc, chrome, edge, firefox, brave
GROK_BROWSER=brave
# Chromium profile name for Grok cookies (e.g. Default, Profile 1)
GROK_CHROME_PROFILE=Default
# Proxy for Grok (e.g. socks4://host:port) — useful for region blocks
GROK_PROXY=
# Optional raw cookies for grok.com (skips browser extraction)
# Format: name=value; name2=value2
GROK_COOKIE=
# Optional x-statsig-id override. If unset, a headless browser bootstraps it
# automatically (requires chromium/chrome/brave installed).
GROK_X_STATSIG_ID=

# ===== Grok headless browser bootstrap =====
# Path to chrome/chromium/brave binary. Leave empty to auto-detect.
GROK_BROWSER_EXECUTABLE=
# Run the bootstrap browser headless (set false to debug visually)
GROK_BROWSER_HEADLESS=true
# Seconds to wait for x-statsig-id capture inside the browser
GROK_BOOTSTRAP_TIMEOUT=30
# Cached session TTL in seconds before forcing a re-bootstrap
GROK_SESSION_TTL=900

# ===== Behavior =====
# Disable ChatGPT conversation history
HISTORY_DISABLED=true
# Skip sentinel/chat-requirements handshake (dev only, may cause failures)
CONVERSATION_ONLY=false
